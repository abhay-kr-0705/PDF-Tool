# ==========================================
# Hostinger FTP Deployment Configuration
# Copy this file to .env.deploy and fill in your details:
# cp .env.deploy.example .env.deploy
# ==========================================

# Your Hostinger FTP Host (found in Hostinger hPanel -> Websites -> Manage -> FTP Accounts)
# Examples: ftp.avatarpdf.com or access844983021.webspace-host.com
HOSTINGER_FTP_HOST=ftp.avatarpdf.com

# Your Hostinger FTP Username
# Example: u123456789 or u123456789.avatarpdf
HOSTINGER_FTP_USER=your_ftp_username

# Your Hostinger FTP Password
HOSTINGER_FTP_PASSWORD=your_ftp_password

# Port (Usually 21 for FTP/FTPS)
HOSTINGER_FTP_PORT=21

# Remote Destination Directory on Hostinger (usually public_html or public_html/subfolder)
HOSTINGER_REMOTE_DIR=public_html

# Use Secure TLS (true or false, 'true' recommended for Hostinger)
HOSTINGER_FTP_SECURE=true
